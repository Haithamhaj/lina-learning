modules = ["python-3.12", "nodejs-24", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["postgresql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:api"

[[ports]]
localPort = 5000
externalPort = 80



[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["npm", "run", "start:production"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.production]
API_INTERNAL_ORIGIN = "http://127.0.0.1:8000"
APP_ENV = "production"
MODEL_NAME = "gpt-5.6-luna"
MODEL_PROVIDER = "openai"
NEXT_PUBLIC_API_BASE_URL = "/api"
NEXT_PUBLIC_APP_ENV = "production"
STORAGE_PROVIDER = "replit"

[userenv.shared]
REPLIT_STORAGE_BUCKET_ID = "replit-objstore-01d06202-35ea-40df-a3f9-adb5842f38f2"

[objectStorage]
defaultBucketID = "replit-objstore-01d06202-35ea-40df-a3f9-adb5842f38f2"
