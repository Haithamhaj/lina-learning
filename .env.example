# Server configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5000
ALLOWED_ORIGINS=["http://localhost:5000"]

# Server-only secret. Never rename this with a NEXT_PUBLIC_ prefix.
SESSION_SECRET=

# Database foundation. Required when APP_ENV=production.
DATABASE_URL=

# Object storage foundation
STORAGE_PROVIDER=local
STORAGE_DIR=.local/storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Model-provider foundation. Keep mock until the Model Gateway task is active.
MODEL_PROVIDER=mock
MODEL_NAME=mock
MODEL_BASE_URL=
MODEL_API_KEY=

# Browser-safe values only. NEXT_PUBLIC_* values are included in the frontend bundle.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=/api