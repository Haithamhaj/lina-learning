# Server configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5000
ALLOWED_ORIGINS=["http://localhost:5000"]

# Clerk Auth. Replit provisions these values; do not paste credentials here.
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=

# Server-only secret. Never rename this with a NEXT_PUBLIC_ prefix.
SESSION_SECRET=

# Database foundation. Required when APP_ENV=production.
DATABASE_URL=

# Object storage. Keep production credentials in Replit Secrets.
STORAGE_PROVIDER=local
STORAGE_DIR=.local/storage
# Optional for AWS; required for providers with a custom S3-compatible endpoint.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Objects larger than this use managed multipart transfer (default: 8 MiB).
S3_MULTIPART_THRESHOLD_BYTES=8388608

# Model Gateway. Keep mock for deterministic local fixtures. To test the
# development Sandbox/Test Learner with OpenAI, set MODEL_PROVIDER=openai,
# MODEL_NAME=gpt-5.6-luna, and a local MODEL_API_KEY in the ignored .env file.
MODEL_PROVIDER=mock
MODEL_NAME=mock
MODEL_BASE_URL=
MODEL_API_KEY=
# CTX-03D implementation calibration: serialized model-request characters,
# not an exact provider token limit.
TUTOR_CONTEXT_CAPACITY=64000
# SEG-EVID-01C implementation calibration: deterministic serialized Segment
# Review request characters, not an exact provider token limit.
SEGMENT_REVIEW_CONTEXT_CAPACITY=64000
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Browser-safe values only. NEXT_PUBLIC_* values are included in the frontend bundle.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=/api
